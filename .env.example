# App
APP_NAME="AI Trading Company"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_trading?ssl=disable
REDIS_URL=redis://127.0.0.1:6379/0

# Grafana (docker compose up -d grafana → http://127.0.0.1:3000)
GRAFANA_ADMIN_PASSWORD=admin
# Senha do role somente-leitura criado pela migration 0006
GRAFANA_DB_PASSWORD=grafana_ro

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_AUTONOMY_ENABLED=false
CLOSE_POSITIONS_ON_BOOT=false
STOP_LOSS_ENABLED=false
TAKE_PROFIT_ENABLED=false
CANCEL_PROTECTIVE_ORDERS_ON_CLOSE=true
# Se o stop-loss não puder ser criado, fecha a posição na hora (recomendado: true)
CLOSE_ON_STOP_LOSS_FAILURE=true
# Candle fechado há mais que isto (s) não gera sinal (volta de suspensão, boot)
CANDLE_MAX_EMIT_LAG_S=90
# Saída por tempo: fecha posições abertas há mais de N minutos (0 = desligado)
POSITION_MAX_HOLDING_MINUTES=0
# Risco: perda diária (vale o menor entre o absoluto em USDT e o % do equity,
# contando P&L realizado desde 00:00 UTC + não realizado) e perdas seguidas
RISK_MAX_DAILY_LOSS=1000
RISK_MAX_DAILY_LOSS_PCT=3
RISK_MAX_CONSECUTIVE_LOSSES=4
# Exposição total (posições abertas + uma nova) até X vezes o equity (0 desliga)
RISK_MAX_TOTAL_EXPOSURE_X=2
# Alavancagem aplicada em cada ativo no boot e usada na checagem de margem
RISK_MAX_LEVERAGE=3
# Saldo livre precisa cobrir notional / alavancagem × folga (0 desliga)
RISK_MARGIN_BUFFER=1.2
# Falhas operacionais criam trava global, liberada só por trading_control.py resume
# (0 desliga cada uma): reconciliações seguidas com divergência / com erro,
# erros seguidos da corretora ao executar sinais, verificações seguidas com
# posição sem stop-loss. Chave rejeitada (auth) trava na hora.
HALT_RECONCILIATION_RUNS=2
HALT_RECONCILIATION_ERRORS=3
HALT_API_ERRORS=3
HALT_UNPROTECTED_RUNS=2
ML_MIN_DEPLOY_AUC=0.58
# Modelos mantidos em models/ por símbolo/horizonte após cada treino (0 = sem limpeza)
ML_MODEL_RETENTION=5
