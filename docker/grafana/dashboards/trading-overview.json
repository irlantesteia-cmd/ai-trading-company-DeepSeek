          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(generated_at, '1h'), COALESCE(decision, 'PENDENTE') AS metric, COUNT(*) AS value FROM signals WHERE $__timeFilter(generated_at) GROUP BY 1, 2 ORDER BY 1"
        }
