    {
      "id": 16,
      "type": "table",
      "title": "Último candle por símbolo",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-trading"
      },
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-trading"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT symbol AS \"Símbolo\", interval AS \"Intervalo\", COUNT(*) AS \"Candles\", MAX(open_time) AS \"Último candle\", ROUND(EXTRACT(EPOCH FROM (now() - MAX(close_time))) / 3600.0, 1) AS \"Atraso (h)\" FROM candles GROUP BY symbol, interval ORDER BY symbol"
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Candles parciais no banco",
      "datasource": {
        "type": "grafana-postgresql-datasource",
