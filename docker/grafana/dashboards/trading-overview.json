    {
      "id": 22,
      "type": "table",
      "title": "Motivos de rejeição",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-trading"
      },
      "gridPos": {
        "x": 12,
        "y": 67,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
