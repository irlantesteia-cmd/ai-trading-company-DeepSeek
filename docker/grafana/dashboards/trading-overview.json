          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(exchange_created_at, '1h'), status AS metric, COUNT(*) AS value FROM orders WHERE $__timeFilter(exchange_created_at) GROUP BY 1, 2 ORDER BY 1"
        }
