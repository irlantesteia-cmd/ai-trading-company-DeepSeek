          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT decision_reason AS \"Motivo\", COUNT(*) AS \"Sinais\" FROM signals WHERE decision = 'REJECTED' AND $__timeFilter(generated_at) GROUP BY decision_reason ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 23,
      "type": "table",
      "title": "Últimos sinais e ordem gerada",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-trading"
      },
      "gridPos": {
        "x": 0,
        "y": 71,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-trading"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.generated_at AS \"Gerado em\", s.symbol AS \"Símbolo\", s.direction AS \"Direção\", ROUND(s.confidence::numeric, 3) AS \"Confiança\", s.strategy AS \"Estratégia\", COALESCE(s.decision, 'PENDENTE') AS \"Decisão\", s.decision_reason AS \"Motivo\", o.status AS \"Ordem\", o.average_price AS \"Preço médio\" FROM signals s LEFT JOIN orders o ON o.client_order_id = s.client_order_id ORDER BY s.generated_at DESC LIMIT 30"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Divergências por reconciliação",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-trading"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-trading"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT checked_at AS time, jsonb_array_length(missing_on_exchange) + jsonb_array_length(missing_in_db) AS \"Divergências\", jsonb_array_length(synced) AS \"Corrigidas\", jsonb_array_length(unresolved) AS \"Não resolvidas\" FROM reconciliation_runs WHERE $__timeFilter(checked_at) ORDER BY checked_at"
        }
      ]
    },
    {
      "id": 25,
      "type": "table",
      "title": "Reconciliações com divergência não resolvida",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-trading"
      },
      "gridPos": {
        "x": 12,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-trading"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT checked_at AS \"Em\", market_type AS \"Mercado\", unresolved::text AS \"Não resolvidas\", missing_on_exchange::text AS \"Sumiram da exchange\", missing_in_db::text AS \"Faltavam no banco\" FROM reconciliation_runs WHERE NOT balanced AND $__timeFilter(checked_at) ORDER BY checked_at DESC LIMIT 20"
        }
      ]
    },
    {
