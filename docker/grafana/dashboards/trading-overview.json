    {
      "id": 20,
      "type": "stat",
      "title": "Taxa de aprovação",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-trading"
      },
      "gridPos": {
        "x": 12,
        "y": 63,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-trading"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * COUNT(*) FILTER (WHERE decision = 'APPROVED') / NULLIF(COUNT(*) FILTER (WHERE decision IN ('APPROVED', 'REJECTED')), 0) AS \"Aprovados\" FROM signals WHERE $__timeFilter(generated_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
