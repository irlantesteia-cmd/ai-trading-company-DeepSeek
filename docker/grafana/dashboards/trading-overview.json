      "type": "table",
      "title": "SL/TP abertos",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-trading"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-trading"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT symbol AS \"Símbolo\", type AS \"Tipo\", side AS \"Lado\", stop_price AS \"Gatilho\", quantity AS \"Qtd\", client_order_id AS \"Client ID\", exchange_created_at AS \"Criada em\" FROM orders WHERE is_conditional AND status IN ('NEW', 'PARTIALLY_FILLED') ORDER BY exchange_created_at DESC"
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "Ordens rejeitadas",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-trading"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-trading"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT exchange_created_at AS \"Em\", symbol AS \"Símbolo\", type AS \"Tipo\", side AS \"Lado\", quantity AS \"Qtd\", client_order_id AS \"Client ID\" FROM orders WHERE status = 'REJECTED' AND $__timeFilter(exchange_created_at) ORDER BY exchange_created_at DESC LIMIT 50"
        }
