      "type": "stat",
      "title": "Status do trading",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-trading"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-trading"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN COUNT(*) = 0 THEN 'ATIVO' ELSE 'TRAVADO' END AS \"Status\" FROM trading_halts WHERE cleared_at IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
